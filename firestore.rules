rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function staff() {
      return signedIn()
        && request.auth.token.get('role', '') in [
          'admin', 'staff', 'founder', 'owner', 'modder', 'tester', 'helper'
        ];
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validText(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    match /users/{userId} {
      allow read: if true;

      allow create: if owns(userId)
        && request.resource.data.get('role', 'user') == 'user'
        && request.resource.data.get('diamonds', 0) == 0
        && request.resource.data.keys().hasOnly([
          'displayName', 'usernameTag', 'imgprofile', 'bannerUrl', 'bio',
          'email', 'showEmail', 'role', 'diamonds', 'consent',
          'createdAt', 'updatedAt', 'provider'
        ]);

      allow update: if owns(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'usernameTag', 'imgprofile', 'bannerUrl',
          'bio', 'email', 'showEmail', 'updatedAt'
        ]);

      allow delete: if false;

      match /blocked/{blockedUid} {
        allow read: if owns(userId);
        allow create: if owns(userId)
          && blockedUid != userId
          && request.resource.data.keys().hasOnly(['at']);
        allow delete: if owns(userId);
        allow update: if false;
      }
    }

    match /posts/{postId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.get('role', 'user') == (staff() ? request.auth.token.role : 'user')
        && request.resource.data.get('text', '') is string
        && request.resource.data.get('mediaUrl', '') is string
        && request.resource.data.keys().hasOnly([
          'authorId', 'authorName', 'usernameTag', 'imgprofile', 'role',
          'text', 'mediaUrl', 'mediaType', 'likeCount', 'likes',
          'reports', 'createdAt'
        ]);

      allow update: if signedIn()
        && request.resource.data.authorId == resource.data.authorId
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['likes', 'likeCount'])
            && request.resource.data.get('likes', {}) is map
            && request.resource.data.get('likes', {}).diff(resource.data.get('likes', {}))
              .affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.likeCount is int
            && request.resource.data.likeCount >= 0
            && request.resource.data.likeCount <= resource.data.get('likeCount', 0) + 1
            && request.resource.data.likeCount >= resource.data.get('likeCount', 0) - 1
          )
          ||
          (
            (resource.data.authorId == request.auth.uid || staff())
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['text', 'mediaUrl', 'mediaType'])
          )
        );

      allow delete: if signedIn()
        && (resource.data.authorId == request.auth.uid || staff());

      match /comments/{commentId} {
        allow read: if true;

        allow create: if signedIn()
          && request.resource.data.keys().hasOnly([
            'postId', 'authorId', 'parentCommentId', 'authorName',
            'usernameTag', 'imgprofile', 'text', 'createdAt'
          ])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.postId == postId
          && validText(request.resource.data.text, 3000)
          && validText(request.resource.data.authorName, 80)
          && request.resource.data.get('usernameTag', '') is string
          && request.resource.data.get('imgprofile', '') is string
          && (
            request.resource.data.get('parentCommentId', null) == null
            || (
              request.resource.data.parentCommentId is string
              && exists(
                /databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.parentCommentId)
              )
            )
          );

        allow update: if signedIn()
          && resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.postId == resource.data.postId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])
          && validText(request.resource.data.text, 3000);

        allow delete: if signedIn()
          && (resource.data.authorId == request.auth.uid || staff());
      }
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType in ['post', 'comment', 'user']
        && validText(request.resource.data.targetId, 200)
        && validText(request.resource.data.reason, 1000)
        && request.resource.data.get('status', 'open') == 'open'
        && request.resource.data.keys().hasOnly([
          'reporterId', 'targetType', 'targetId', 'postId',
          'reason', 'status', 'createdAt'
        ]);

      allow read, update, delete: if staff();
    }

    match /private_messages/{messageId} {
      allow create: if signedIn()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.recipientUid is string
        && request.resource.data.recipientUid != request.auth.uid
        && validText(request.resource.data.text, 10000)
        && request.resource.data.keys().hasOnly([
          'senderUid', 'senderEmail', 'recipientUid', 'recipientEmail',
          'text', 'read', 'createdAt'
        ]);

      allow read: if signedIn()
        && (
          resource.data.senderUid == request.auth.uid
          || resource.data.recipientUid == request.auth.uid
        );

      allow update: if signedIn()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;

      allow delete: if staff();
    }

    match /bannedworlds/{wordId} {
      allow read: if true;
      allow create, update, delete: if staff();
    }

    match /system/{document} {
      allow read: if true;
      allow create, update, delete: if staff();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
